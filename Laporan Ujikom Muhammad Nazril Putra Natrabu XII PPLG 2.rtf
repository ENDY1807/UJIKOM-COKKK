\f3\i0\b0\fs18 \cf4 -- DATABASE RESTORAN NUSANTARA "RASANTARA"\
-- UJI KOMPETENSI KEAHLIAN (UKK) REKAYASA PERANGKAT LUNAK 2026/2027\
-- Paket 1 - Aplikasi Kasir & Pemesanan Meja Restoran (Table Service)\
\
CREATE TYPE auth_provider_type AS ENUM ('local', 'google', 'both');\
CREATE TYPE status_meja_type AS ENUM ('Kosong', 'Terisi', 'Reservasi');\
CREATE TYPE kategori_masakan_type AS ENUM ('Makanan', 'Minuman', 'Paket', 'Addon');\
CREATE TYPE status_masakan_type AS ENUM ('Tersedia', 'Habis');\
CREATE TYPE status_order_type AS ENUM ('Menunggu', 'Diproses', 'Selesai', 'Dibatalkan');\
CREATE TYPE status_detail_type AS ENUM ('Menunggu', 'Dimasak', 'Disajikan');\
\
CREATE TABLE tb_level (\
    id_level SERIAL PRIMARY KEY,\
    nama_level VARCHAR(30) NOT NULL UNIQUE\
);\
\
CREATE TABLE tb_user (\
    id_user SERIAL PRIMARY KEY,\
    username VARCHAR(50) UNIQUE,\
    password VARCHAR(255) DEFAULT '',\
    nama_user VARCHAR(100) NOT NULL,\
    id_level INT NOT NULL DEFAULT 5 REFERENCES tb_level(id_level),\
    phone_number VARCHAR(30) DEFAULT '',\
    foto_profil VARCHAR(500) DEFAULT NULL,\
    auth_provider auth_provider_type NOT NULL DEFAULT 'local',\
    google_uid VARCHAR(128) UNIQUE DEFAULT NULL,\
    google_email VARCHAR(150) UNIQUE DEFAULT NULL,\
    is_subscribed BOOLEAN NOT NULL DEFAULT FALSE,\
    is_two_factor_enabled BOOLEAN NOT NULL DEFAULT FALSE,\
    is_active BOOLEAN NOT NULL DEFAULT TRUE,\
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\
);\
\
CREATE TABLE tb_meja (\
    id_meja SERIAL PRIMARY KEY,\
    nomor_meja VARCHAR(20) NOT NULL UNIQUE,\
    kapasitas INT NOT NULL DEFAULT 4,\
    status_meja status_meja_type NOT NULL DEFAULT 'Kosong',\
    qr_code_payload VARCHAR(255) DEFAULT '',\
    floor_zone VARCHAR(50) DEFAULT 'Lantai 1'\
);\
\
CREATE TABLE tb_masakan (\
    id_masakan SERIAL PRIMARY KEY,\
    nama_masakan VARCHAR(100) NOT NULL,\
    kategori_masakan kategori_masakan_type NOT NULL,\
    harga INT NOT NULL,\
    status_masakan status_masakan_type NOT NULL DEFAULT 'Tersedia',\
    stok INT NOT NULL DEFAULT 50,\
    gambar_url VARCHAR(500) DEFAULT '',\
    deskripsi TEXT DEFAULT ''\
);\
\
CREATE TABLE tb_order (\
    id_order SERIAL PRIMARY KEY,\
    nomor_order VARCHAR(50) NOT NULL UNIQUE,\
    id_meja INT NOT NULL REFERENCES tb_meja(id_meja),\
    id_user INT NOT NULL REFERENCES tb_user(id_user),\
    tanggal DATE NOT NULL DEFAULT CURRENT_DATE,\
    status_order status_order_type NOT NULL DEFAULT 'Menunggu',\
    total_harga INT NOT NULL DEFAULT 0,\
    \
    \
    \
    diskon_member INT DEFAULT 0,\
    \
);\
\
CREATE TABLE tb_detail_order (\
    id_detail_order SERIAL PRIMARY KEY,\
    id_order INT NOT NULL REFERENCES tb_order(id_order) ON DELETE CASCADE,\
    id_masakan INT NOT NULL REFERENCES tb_masakan(id_masakan),\
    jumlah INT NOT NULL DEFAULT 1,\
    harga_satuan INT NOT NULL,\
    subtotal INT NOT NULL,\
    catatan VARCHAR(255) DEFAULT '',\
    status_detail status_detail_type NOT NULL DEFAULT 'Menunggu'\
);\
\
CREATE TABLE tb_transaksi (\
    id_transaksi SERIAL PRIMARY KEY,\
    id_order INT NOT NULL REFERENCES tb_order(id_order),\
    id_user INT NOT NULL REFERENCES tb_user(id_user),\
    tanggal_bayar TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\
    total_bayar INT NOT NULL,\
    jumlah_bayar INT NOT NULL,\
    kembalian INT NOT NULL DEFAULT 0,\
    metode_pembayaran VARCHAR(50) NOT NULL DEFAULT 'Tunai',\
    referensi_pembayaran VARCHAR(100) DEFAULT '',\
    status_transaksi VARCHAR(30) NOT NULL DEFAULT 'Lunas'\
);\cell \lastrow\row
