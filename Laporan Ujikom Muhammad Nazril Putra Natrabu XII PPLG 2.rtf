\f3\i0\b0\fs18 \cf4 -- 3. TABEL MEJA & STATUS OKUPANSI\
CREATE TYPE status_meja_type AS ENUM ('Kosong', 'Terisi', 'Reservasi');\
CREATE TABLE tb_meja (\
    id_meja SERIAL PRIMARY KEY,\
    nomor_meja VARCHAR(20) NOT NULL UNIQUE,\
    kapasitas INT NOT NULL DEFAULT 4,\
    status_meja status_meja_type NOT NULL DEFAULT 'Kosong',\
    qr_code_payload VARCHAR(255) DEFAULT '',\
    floor_zone VARCHAR(50) DEFAULT 'Lantai 1'\
);\
\
-- 4. TABEL MENU MASAKAN & STOK\
CREATE TYPE kategori_masakan_type AS ENUM ('Makanan', 'Minuman', 'Paket', 'Addon');\
CREATE TYPE status_masakan_type AS ENUM ('Tersedia', 'Habis');\
CREATE TABLE tb_masakan (\
    id_masakan SERIAL PRIMARY KEY,\
    nama_masakan VARCHAR(100) NOT NULL,\
    kategori_masakan kategori_masakan_type NOT NULL,\
    harga INT NOT NULL,\
    status_masakan status_masakan_type NOT NULL DEFAULT 'Tersedia',\
    stok INT NOT NULL DEFAULT 50,\
    gambar_url VARCHAR(500) DEFAULT '',\
    deskripsi TEXT DEFAULT ''\
);\
\
-- 5. TABEL TRANSAKSI PEMBAYARAN KASIR\
CREATE TABLE tb_transaksi (\
    id_transaksi SERIAL PRIMARY KEY,\
    id_order INT NOT NULL REFERENCES tb_order(id_order) ON DELETE RESTRICT,\
    id_user INT NOT NULL REFERENCES tb_user(id_user) ON DELETE RESTRICT,\
    tanggal_bayar TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\
    total_bayar INT NOT NULL,\
    jumlah_bayar INT NOT NULL,\
    kembalian INT NOT NULL DEFAULT 0,\
    metode_pembayaran VARCHAR(50) NOT NULL DEFAULT 'Tunai',\
    referensi_pembayaran VARCHAR(100) DEFAULT '',\
    status_transaksi VARCHAR(30) NOT NULL DEFAULT 'Lunas'\
);\cell \lastrow\row
